<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Push / partner landings still ship http:// (e.g. afsub.com). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">afsub.com</domain>
        <domain includeSubdomains="true">team-s.club</domain>
    </domain-config>
</network-security-config>
